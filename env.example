# 应用配置
APP_NAME=易骑公会官方网站
APP_VERSION=3.0.0
ENVIRONMENT=development
DEBUG=true

# 服务器配置
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=3000

# 数据库配置
DATABASE_URL=sqlite:///./data/database/guild.db
# DATABASE_URL=postgresql://yiqi:password@localhost:5432/yiqi_guild

# Redis配置
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# 缓存配置
CACHE_DIR=./data/cache
CACHE_TTL=3600

# 日志配置
LOG_DIR=./data/logs
LOG_LEVEL=INFO

# API配置
API_BASE_URL=http://localhost:8000
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 暴雪API配置
BLIZZARD_CLIENT_ID=your_blizzard_client_id
BLIZZARD_CLIENT_SECRET=your_blizzard_client_secret
BLIZZARD_REGION=cn

# WarcraftLogs配置
WCL_CLIENT_ID=your_wcl_client_id
WCL_CLIENT_SECRET=your_wcl_client_secret

# 文件上传配置
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

# Cloudinary配置（可选）
CLOUDINARY_URL=cloudinary://your_cloudinary_url
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 安全配置
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# 监控配置
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# 开发工具配置
HOT_RELOAD=true
AUTO_MIGRATE=true
SEED_DATA=true

# 公会配置
GUILD_NAME=一起公会
GUILD_REALM=艾泽拉斯
GUILD_REGION=cn
GUILD_FACTION=alliance

# 爬虫配置
CRAWLER_DELAY=1
CRAWLER_TIMEOUT=30
CRAWLER_RETRIES=3
CRAWLER_MAX_WORKERS=4
CRAWLER_HEADLESS=true

# 统计配置
STATS_UPDATE_INTERVAL=3600  # 1小时
STATS_CACHE_TTL=1800       # 30分钟 