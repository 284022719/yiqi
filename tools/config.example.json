{
  "_comment": "示例配置：复制为 tools/config.json（已被 .gitignore 忽略）后填入自己的值。令牌建议走环境变量 WOW_ARMORY_TOKEN，不要写进来。",
  "api": {
    "base_url": "https://webapi.blizzard.cn/wow-armory-server/api/do",
    "headers": {
      "accept": "application/json, text/javascript, */*; q=0.01",
      "accept-language": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6",
      "priority": "u=1, i",
      "sec-fetch-dest": "empty",
      "sec-fetch-mode": "cors",
      "sec-fetch-site": "same-site",
      "xcxtoken": "",
      "referer": "https://wow.blizzard.cn/"
    },
    "timeout": 30,
    "max_retries": 3
  },
  "crawler": {
    "delay_between_requests": 2,
    "batch_size": 10,
    "max_concurrent": 12
  },
  "database": {
    "path": "../guild_database.db",
    "backup_before_update": true
  },
  "logging": {
    "level": "INFO",
    "file": "logs/mounts_crawler.log",
    "max_size": "10MB",
    "backup_count": 5
  },
  "tokens": {
    "default": "",
    "characters": {},
    "realms": {}
  }
}
